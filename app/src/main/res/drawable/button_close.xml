<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ui_primary_ripple">
    <item>
        <selector>
            <item android:state_focused="true"><shape><solid android:color="@color/ui_active_fill" /><stroke android:width="2dp" android:color="@color/ui_on_active" /><corners android:radius="14dp" /></shape></item>
            <item><shape><solid android:color="@color/ui_active_fill" /><stroke android:width="1dp" android:color="@color/ui_active" /><corners android:radius="14dp" /></shape></item>
        </selector>
    </item>
</ripple>
