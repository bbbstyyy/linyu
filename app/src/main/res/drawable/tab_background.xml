<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ui_ripple">
    <item><selector>
        <item android:state_focused="true"><shape><solid android:color="@color/ui_secondary" /><stroke android:width="2dp" android:color="@color/ui_primary" /><corners android:radius="16dp" /></shape></item>
        <item android:state_checked="true"><shape><solid android:color="@color/ui_tab_surface" /><corners android:radius="16dp" /></shape></item>
        <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="16dp" /></shape></item>
    </selector></item>
</ripple>
