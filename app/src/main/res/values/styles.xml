<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ui_primary</item>
        <item name="android:colorPrimary">@color/ui_primary</item>
        <item name="android:colorPrimaryDark">@color/ui_background</item>
        <item name="android:colorControlNormal">@color/ui_muted</item>
        <item name="android:colorControlActivated">@color/ui_primary</item>
        <item name="android:colorButtonNormal">@color/ui_secondary</item>
        <item name="android:colorBackground">@color/ui_surface</item>
        <item name="android:colorBackgroundFloating">@color/ui_surface</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_muted</item>
        <item name="android:colorControlHighlight">@color/ui_ripple</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
        <item name="android:windowBackground">@color/ui_background</item>
    </style>
    <style name="WidgetText">
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeStepGranularity">1dp</item>
    </style>
    <style name="WidgetNumber" parent="WidgetText">
        <item name="android:text">@string/widget_number</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:autoSizeMinTextSize">16dp</item>
        <item name="android:autoSizeMaxTextSize">30sp</item>
    </style>
    <style name="WidgetStatus" parent="WidgetText">
        <item name="android:text">@string/widget_idle</item>
        <item name="android:textColor">@color/ui_primary</item>
        <item name="android:background">@drawable/widget_status_ready</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:autoSizeMinTextSize">12dp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
    </style>
    <style name="WidgetBalance" parent="WidgetText">
        <item name="android:text">@string/widget_balance_unknown</item>
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:autoSizeMinTextSize">12dp</item>
        <item name="android:autoSizeMaxTextSize">16sp</item>
    </style>
    <style name="WidgetAction">
        <item name="android:text">@string/widget_open</item>
        <item name="android:textColor">@color/ui_on_primary</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">14dp</item>
        <item name="android:autoSizeMaxTextSize">18sp</item>
        <item name="android:autoSizeStepGranularity">1dp</item>
    </style>
</resources>
